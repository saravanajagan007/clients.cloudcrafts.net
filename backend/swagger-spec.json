{
  "openapi": "3.0.0",
  "info": {
    "title": "AgencyOS API",
    "version": "1.0.0",
    "description": "Production OpenAPI 3.0 Specification for AgencyOS Multi-Tenant CRM Engine"
  },
  "servers": [
    {
      "url": "https://api.cloudcrafts.net/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate User & Return JWT + Tenant Context",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "JWT Access & Refresh Tokens Returned" }
        }
      }
    },
    "/leads": {
      "get": {
        "summary": "Get Tenant Leads with Filtering & Pagination",
        "parameters": [
          { "name": "stage", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of Lead Objects" }
        }
      },
      "post": {
        "summary": "Create New Lead Entry",
        "responses": {
          "201": { "description": "Lead Created Successfully" }
        }
      }
    },
    "/proposals/generate": {
      "post": {
        "summary": "AI Generated Proposal Engine",
        "responses": {
          "200": { "description": "Proposal Generated" }
        }
      }
    },
    "/workflows/execute": {
      "post": {
        "summary": "Trigger Automation Workflow Engine",
        "responses": {
          "200": { "description": "Workflow Executed" }
        }
      }
    }
  }
}
